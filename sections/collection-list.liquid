{% schema %}
{
  "name": "Collection list",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "[Watch tutorial](https://foxecom.link/gFSv60)"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        { "label": "Medium", "value": "h3" },
        { "label": "Large", "value": "h2" }
      ]
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Standard" },
        { "value": "left-side", "label": "Heading left side" }
      ]
    },
    {
      "type": "checkbox",
      "id": "expanded",
      "label": "Expanded",
      "default": true,
      "info": "Work if Enable slider is checked"
    },
    {
      "type": "header",
      "content": "Card settings"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "overlay",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "boxed", "label": "Boxed" },
        { "value": "inside", "label": "Content inside" },
        { "value": "overlay", "label": "Overlay with button" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "default": "scaling-down",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "scaling-down", "label": "Scaling down" },
        { "value": "scaling-up", "label": "Scaling up" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "count_inline_title",
      "label": "Product count inline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "image_rounded",
      "label": "Image rounded",
      "default": false,
      "info": "Don't work well with \"Content inside\" layout"
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Column gap",
      "min": 0,
      "max": 50,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "Auto slide",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Auto slide every",
      "max": 10,
      "min": 2,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "checkbox",
      "label": "Disable slider",
      "id": "mobile_disable_slider",
      "default": false
    },
    {
      "type": "checkbox",
      "label": "Use horizontal scrollbar",
      "id": "use_scroll_mobile",
      "default": true,
      "info": "Uncheck to display as grid"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Column gap",
      "min": 0,
      "max": 30,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "hidden_slide_control_mobile",
      "label": "Hide slider controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit global setting" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-in-up", "label": "Fade in up" },
        { "value": "fade-in-left", "label": "Fade in left" },
        { "value": "fade-in-right", "label": "Fade in right" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave blank to use collection's title"
        },
        {
          "type": "image_picker",
          "id": "item_image",
          "label": "Featured image"
        },
        {
          "type": "header",
          "content": "Overlay button settings (\"Overlay\" style)"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "Button background",
          "default": "#5f2d91"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "header",
          "content": "General"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New season in town"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Claritas est etiam processus dynamicus qui sequitur."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "item_bg",
          "label": "Background",
          "default": "#000"
        },
        {
          "type": "color",
          "id": "item_text_color",
          "label": "Text color",
          "default": "#fff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "category": "Collection",
      "blocks": [
        {
          "type": "collection_block",
          "settings": {
            "title": "Shop for boy",
            "button_bg": "#5f2d91"
          }
        },
        {
          "type": "collection_block",
          "settings": {
            "title": "Shop for girl",
            "button_bg": "#e97c3a"
          }
        },
        {
          "type": "collection_block",
          "settings": {
            "title": "Bath",
            "button_bg": "#2e6b7f"
          }
        },
        {
          "type": "collection_block",
          "settings": {
            "title": "Women's pajamas",
            "button_bg": "#a4c56b"
          }
        }
      ]
    }
  ]
}
{% endschema %}