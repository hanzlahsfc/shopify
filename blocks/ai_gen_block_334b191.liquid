{% doc %}
  @prompt
    A line to add pages to , make it able to link collections as well
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-page-nav__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.link_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-page-nav__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: color 0.3s ease;
    padding: {{ block.settings.link_padding }}px 0;
    position: relative;
  }

  .ai-page-nav__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  {% if block.settings.show_underline %}
    .ai-page-nav__link-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background-color: {{ block.settings.link_hover_color }};
      transition: width 0.3s ease;
    }

    .ai-page-nav__link-{{ ai_gen_id }}:hover::after {
      width: 100%;
    }
  {% endif %}

  .ai-page-nav__separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-page-nav-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-page-nav__container-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
      gap: {{ block.settings.link_spacing | times: 0.8 }}px;
    }

    .ai-page-nav__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<nav class="ai-page-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-page-nav__container-{{ ai_gen_id }}">
    {% liquid
      assign link_1_url = ''
      assign link_1_title = ''
      assign link_2_url = ''
      assign link_2_title = ''
      assign link_3_url = ''
      assign link_3_title = ''
      assign link_4_url = ''
      assign link_4_title = ''
      assign link_5_url = ''
      assign link_5_title = ''
      assign link_6_url = ''
      assign link_6_title = ''
      assign link_7_url = ''
      assign link_7_title = ''

      if block.settings.link_1_type == 'page' and block.settings.link_1_page != blank
        assign link_1_url = block.settings.link_1_page.url
        assign link_1_title = block.settings.link_1_page.title
      elsif block.settings.link_1_type == 'collection' and block.settings.link_1_collection != blank
        assign link_1_url = block.settings.link_1_collection.url
        assign link_1_title = block.settings.link_1_collection.title
      endif

      if block.settings.link_2_type == 'page' and block.settings.link_2_page != blank
        assign link_2_url = block.settings.link_2_page.url
        assign link_2_title = block.settings.link_2_page.title
      elsif block.settings.link_2_type == 'collection' and block.settings.link_2_collection != blank
        assign link_2_url = block.settings.link_2_collection.url
        assign link_2_title = block.settings.link_2_collection.title
      endif

      if block.settings.link_3_type == 'page' and block.settings.link_3_page != blank
        assign link_3_url = block.settings.link_3_page.url
        assign link_3_title = block.settings.link_3_page.title
      elsif block.settings.link_3_type == 'collection' and block.settings.link_3_collection != blank
        assign link_3_url = block.settings.link_3_collection.url
        assign link_3_title = block.settings.link_3_collection.title
      endif

      if block.settings.link_4_type == 'page' and block.settings.link_4_page != blank
        assign link_4_url = block.settings.link_4_page.url
        assign link_4_title = block.settings.link_4_page.title
      elsif block.settings.link_4_type == 'collection' and block.settings.link_4_collection != blank
        assign link_4_url = block.settings.link_4_collection.url
        assign link_4_title = block.settings.link_4_collection.title
      endif

      if block.settings.link_5_type == 'page' and block.settings.link_5_page != blank
        assign link_5_url = block.settings.link_5_page.url
        assign link_5_title = block.settings.link_5_page.title
      elsif block.settings.link_5_type == 'collection' and block.settings.link_5_collection != blank
        assign link_5_url = block.settings.link_5_collection.url
        assign link_5_title = block.settings.link_5_collection.title
      endif

      if block.settings.link_6_type == 'page' and block.settings.link_6_page != blank
        assign link_6_url = block.settings.link_6_page.url
        assign link_6_title = block.settings.link_6_page.title
      elsif block.settings.link_6_type == 'collection' and block.settings.link_6_collection != blank
        assign link_6_url = block.settings.link_6_collection.url
        assign link_6_title = block.settings.link_6_collection.title
      endif

      if block.settings.link_7_type == 'page' and block.settings.link_7_page != blank
        assign link_7_url = block.settings.link_7_page.url
        assign link_7_title = block.settings.link_7_page.title
      elsif block.settings.link_7_type == 'collection' and block.settings.link_7_collection != blank
        assign link_7_url = block.settings.link_7_collection.url
        assign link_7_title = block.settings.link_7_collection.title
      endif
    %}

    {% if link_1_url != blank %}
      <a href="{{ link_1_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_1_title }}
      </a>
      {% if block.settings.show_separator and link_2_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_2_url != blank %}
      <a href="{{ link_2_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_2_title }}
      </a>
      {% if block.settings.show_separator and link_3_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_3_url != blank %}
      <a href="{{ link_3_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_3_title }}
      </a>
      {% if block.settings.show_separator and link_4_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_4_url != blank %}
      <a href="{{ link_4_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_4_title }}
      </a>
      {% if block.settings.show_separator and link_5_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_5_url != blank %}
      <a href="{{ link_5_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_5_title }}
      </a>
      {% if block.settings.show_separator and link_6_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_6_url != blank %}
      <a href="{{ link_6_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_6_title }}
      </a>
      {% if block.settings.show_separator and link_7_url != blank %}
        <span class="ai-page-nav__separator-{{ ai_gen_id }}">{{ block.settings.separator_text }}</span>
      {% endif %}
    {% endif %}

    {% if link_7_url != blank %}
      <a href="{{ link_7_url }}" class="ai-page-nav__link-{{ ai_gen_id }}">
        {{ link_7_title }}
      </a>
    {% endif %}
  </div>
</nav>

